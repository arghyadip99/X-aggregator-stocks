# Groq API (get free key at console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Gmail credentials (sender must have App Password enabled)
GMAIL_SENDER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
RECIPIENT_EMAIL=your_recipient@gmail.com

# Supabase (get from supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
